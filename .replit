modules = ["nodejs-20", "web", "bash", "python-base-3.13"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && node index.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[userenv]

[userenv.shared]
CLOUDINARY_API_KEY = "861455542942942"
CLOUDINARY_CLOUD_NAME = "wiuxxcvz"
MONGODB_DB_NAME = "cnc_ecom"
ADMIN_EMAIL = "admin@cnccrafts.com"
# ParcelGuru logistics — live backend needs these to push "ready_to_ship" shipments.
# Copy the same values that are in your local .env (server) so the live site behaves like localhost.
PARCELGURU_BASE_URL = "https://demo.myparcelguru.com"
# TODO: set your real key here (same as local .env PARCELGURU_API_KEY)
PARCELGURU_API_KEY = ""

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server/index.js"]
build = ["bash", "-c", "cd client && npm install && npm run build && cd ../server && npm install"]
